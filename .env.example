APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/crm.sqlite3
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ADMIN_USERNAME=admin
# Generate: python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=12
APP_TIMEZONE=Europe/Moscow
APP_CURRENCY=RUB
LOG_LEVEL=INFO
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14

# Google export (optional for local CRM without export)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_EXPORT_FOLDER_NAME=CRM Экспорт
EXPORT_MAX_ROWS=10000
EXPORT_TIMEOUT_SECONDS=60
